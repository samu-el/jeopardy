{
  "name": "jeopardy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": "22.x",
    "bun": "1.3.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "foundation:verify": "bun run scripts/verify-foundation.ts",
    "verify": "bun run typecheck && bun run typecheck:worker && bun run lint && bun run test && bun run build && bun run foundation:verify",
    "typecheck:worker": "tsc --noEmit -p workers/rooms/tsconfig.json",
    "rooms:dev": "wrangler dev --config workers/rooms/wrangler.jsonc --port 8787",
    "rooms:deploy": "wrangler deploy --config workers/rooms/wrangler.jsonc"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "next": "^16.2.6",
    "openai": "^6.38.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.129.1"
  }
}
