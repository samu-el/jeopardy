   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A dropped socket keeps your seat and your score until you come back;\nleaving on purpose hands the seat back. The host chair always belongs\nto somebody who is actually in the room (room-flow.ts \u00b7 ensureHost).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A dropped socket keeps your seat and your score until you come back;\nleaving on purpose hands the seat back. The host chair always belongs\nto somebody who is actually in the room (room-flow.ts \u00b7 ensureHost).",
   "autoResize": false,
   "lineHeight": 1.25
  },
