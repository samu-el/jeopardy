   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The clock does the same work nobody pressed a button for:\n\u00b7 nobody wagered \u2192 stake the minimum and read the clue\n\u00b7 nobody rang in \u2192 close the window, show the answer\n\u00b7 everyone who owes an answer has sent one \u2192 reveal at once\n\u00b7 ruled on and idle \u2192 clear the clue, roll the round over",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The clock does the same work nobody pressed a button for:\n\u00b7 nobody wagered \u2192 stake the minimum and read the clue\n\u00b7 nobody rang in \u2192 close the window, show the answer\n\u00b7 everyone who owes an answer has sent one \u2192 reveal at once\n\u00b7 ruled on and idle \u2192 clear the clue, roll the round over",
   "autoResize": false,
   "lineHeight": 1.25
